# Carrier board: ESP32-S3 N16R8 (16 MB QIO flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# PSRAM at 40 MHz (was 80): PSRAM data went bad (bit flips at the PC's
# power-on, corrupted heap and pointers, 2026-10-26..28); 40 MHz has more
# timing margin and needs no MSPI timing tuning at boot
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Wi-Fi and lwIP stay in internal RAM: their linked lists (lwIP timers, heap
# blocks) crashed the board when corrupted in PSRAM (2026-10-25/26 coredumps:
# CacheError on a one-bit-off pointer in sys_timeout_abs, bad free() in tiT)
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# Console: UART0 = the CH343 USB-C port, at 3 Mbaud. The native
# USB port belongs to TinyUSB (CDC + vendor HID), so no USB-JTAG console.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=3000000
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# A hung board in the case needs a PSU power cycle, so a stall must reboot it
# instead (with a core dump): the main loop feeds the task watchdog
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
# 64-byte data cache lines: faces draw into PSRAM canvases, 15-25% faster
# than with 32-byte lines (no internal RAM cost)
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# USB: one CDC port + one HID interface
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
# WinUSB bulk pipe for the PC service (usb.cpp): 3 KB of internal RAM
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=1024
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=1024
CONFIG_TINYUSB_VENDOR_EPSIZE=512

# FFat partition written by the Arduino build: same wear-levelling sector size
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_FATFS_LFN_STACK=y

CONFIG_LWIP_LOCAL_HOSTNAME="esp32-pc-control"
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=n

# app_main runs setup() then the main loop, on core 1 like Arduino's loopTask
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# One factory app slot, no OTA: firmware goes over USB (scripts/idf_flash.py)
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
# TLS: plain malloc, so small allocations (Wi-Fi WPA3 bignums) stay internal and the
# 16 KB record buffers go to PSRAM (SPIRAM_MALLOC_ALWAYSINTERNAL=4096)
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# TLS dynamic buffers OFF: with them on, closing a large TLS download (GDACS
# cyclone track, 200-350 KB) freed a corrupted mbedTLS buffer block (2 bytes
# written past its end, multi_heap_free assert), which made the board crash-loop
# on 2026-10-27. Off: stable through the same fetches, lowest-ever internal free
# 22 -> 34 KB. Peer certificate still not kept.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
# VFS tables in internal RAM (and select in IRAM): with this off they are
# allocated MALLOC_CAP_DEFAULT and land in PSRAM, where the lwIP socket entry's
# pointers went bad twice (2026-10-27 21:09, 10-28 09:16: esp_vfs_select through
# a garbage pointer in the Discord TLS task)
CONFIG_VFS_SELECT_IN_RAM=y
# PSRAM ECC: the PC powering on sags the board's supply and PSRAM then gave
# single-bit errors (2026-10-28); the MSPI ECC corrects them. Costs 1/16 of
# PSRAM (512 KB of 8 MB).
CONFIG_SPIRAM_ECC_ENABLE=y
# Less code in internal RAM (2026-11-01): heap and ringbuf functions run from
# flash, and the SPI master ISR with them (heap in flash needs it off). None of
# our ISRs are IRAM ones, so nothing calls these while the cache is off.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR is not set
# Software AES: hardware AES needs DMA bounce buffers in internal RAM for PSRAM data
CONFIG_MBEDTLS_HARDWARE_AES=n
# Internal RAM for TLS/sockets: Wi-Fi hot paths stay in flash, fewer fixed RX buffers
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# static TX buffers sit in internal RAM for good: 6 (was 16, then 8). Static was the default only
# while SPIRAM_TRY_ALLOCATE_WIFI_LWIP was on, so it is spelled out (a fresh build got dynamic)
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
# the running board's value, also left over from SPIRAM_TRY_ALLOCATE_WIFI_LWIP (a fresh build got 4)
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=0
CONFIG_ESP_WIFI_RX_BA_WIN=6
# mDNS packets in PSRAM: at boot the TLS handshakes left no internal RAM and mDNS sends failed
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# stacks trimmed to measured use + margin (bench usage, 2026-10-26)
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
CONFIG_MDNS_TASK_STACK_SIZE=3584
# OwnTracks MQTT is TLS over TCP only (mqtts://); the WebSocket transports were never used
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
