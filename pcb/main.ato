# ============================================================
# ESP32 PC Control System -- carrier PCB (rev 3.1)
# ============================================================
# Houses: ESP32-S3-N16R8 DevKitC-1-style module (44-pin/2x22, 16MB flash/
# 8MB PSRAM, dual USB-C), 5V->12V boost module (soldered on), 3x GMT024
# ST7789 display sockets (shared SPI bus, per-display CS/RST/BL), 5x
# EL817C/PC817 optocoupler bank, 1x status LED, 6x 270R + 5x 10k + 2x 33R,
# a 1x6 keyfob connector and an isolated motherboard-RST pair.
#
# This file is the source of truth for the netlist. The firmware pin map
# (firmware/carrier_main/config.h) is checked against it by
# scripts/check_pins.py.
#
# Pin mapping:
#   - Display bus (shared): MOSI=GPIO11, SCK=GPIO12 (FSPI IO_MUX pins), each
#     through a 33R series resistor at the module, DC=GPIO9.
#     CS1/2/3=GPIO8/18/17, RST1/2/3=GPIO10/16/15 (one hung panel can be
#     reset alone), BL1/2/3=GPIO3/6/5 (on/off or LEDC PWM per panel).
#   - Display VCC is the module's 5Vin pin, not 3V3 -- intentional: the
#     panels carry their own 5V->3.3V regulator, which keeps all three off
#     the module's single 3.3V LDO.
#   - Optocoupler bank: GPIO39/40/41/42/1 -> opto rows 1-5. Rows 1-4 are
#     the door-remote buttons (boost 12V+ bussed to their collectors,
#     emitters out to the keyfob connector). Row 5 is the motherboard
#     reset line: its collector/emitter go ONLY to the RST pair, never to
#     the 12V bus. All five opto GPIOs have a 10k pull-down so no opto can
#     turn on while firmware isn't driving its pin (boot, flashing, crash).
#   - Status LED: GPIO2 -> 270R -> LED -> GND.
#   - The PC link (module's native USB, to the motherboard's internal USB
#     header) needs no carrier copper: it is the module's own second USB-C
#     port on a Type-E-to-Type-C cable.
#
# Every component declares pins as `signal <name> ~ pin <N>`, not a bare
# `pin <name>`: a named pin has no relation to a stock footprint's numbered
# pads and silently binds to nothing. Pad order was confirmed per footprint
# with pcbnew; only the 2x22 socket differs from declaration order (see
# N16R8Socket below).

# ---- discrete building blocks -------------------------------------------

component Resistor270:
    """6x needed: 5 for the PC817 LED drive, 1 for the status LED."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"

component Resistor10k:
    """Opto GPIO pull-down (5x: GPIO1 reset row + GPIO39/40/41/42 doors):
    holds the opto off while firmware isn't driving the pin (boot,
    flashing, crash, deep sleep). Must stay <=~20k to beat a possible ~45k
    internal pull-up at reset."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"

component Resistor33:
    """33R THT series (source) termination on SCK / MOSI, lying flat in the
    board's top-right corner next to the module (MOSI's on the top row, SCK's
    below it): damps reflections on the daisy-chained display bus. Fit a
    wire link (0R) to disable."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"

component StatusLED:
    # KiCad LED_THT footprints: pad 1 (square) = cathode, pad 2 = anode
    signal k ~ pin 1  # cathode
    signal a ~ pin 2  # anode
    footprint = "LED_THT:LED_D5.0mm"

component Optocoupler:
    """EL817C / PC817, DIP-4, 2.54mm pitch, 7.62mm row spacing. Standard
    pinout confirmed against the real footprint's pad geometry: pins 1/2
    (LED side) sit opposite pins 4/3 (phototransistor side) respectively."""
    signal anode     ~ pin 1  # LED+
    signal cathode   ~ pin 2  # LED-
    signal emitter   ~ pin 3  # phototransistor E
    signal collector ~ pin 4  # phototransistor C
    footprint = "Package_DIP:DIP-4_W7.62mm"

# ---- module-interface connectors (female sockets — the module/boards ----
# ---- carry their own soldered-on male DuPont pins and plug into these) --

component Header1x22:
    """One 22-pin single-row 2.54mm female socket -- one half of the
    module's 44-pin/2x22 footprint. Single-row headers number pads
    sequentially 1..22 matching physical top-to-bottom position
    (confirmed project-wide convention, unlike the 2x22 zigzag case
    this replaces -- see N16R8Socket below for why)."""
    signal pin1 ~ pin 1
    signal pin2 ~ pin 2
    signal pin3 ~ pin 3
    signal pin4 ~ pin 4
    signal pin5 ~ pin 5
    signal pin6 ~ pin 6
    signal pin7 ~ pin 7
    signal pin8 ~ pin 8
    signal pin9 ~ pin 9
    signal pin10 ~ pin 10
    signal pin11 ~ pin 11
    signal pin12 ~ pin 12
    signal pin13 ~ pin 13
    signal pin14 ~ pin 14
    signal pin15 ~ pin 15
    signal pin16 ~ pin 16
    signal pin17 ~ pin 17
    signal pin18 ~ pin 18
    signal pin19 ~ pin 19
    signal pin20 ~ pin 20
    signal pin21 ~ pin 21
    signal pin22 ~ pin 22
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x22_P2.54mm_Vertical"

module N16R8Socket:
    """ESP32-S3-N16R8 DevKitC-1-style module, 44-pin/2x22, 2.54mm.
    Pin names/order match the module's own silkscreen, confirmed via
    pixel-level tracing against the reference photo (both columns, top
    to bottom, including the final 1-3 pins on each side that needed a
    dedicated close-up crop to resolve).

    Originally modeled as a single `PinSocket_2x22_P2.54mm_Vertical`
    footprint. That's wrong for a real DevKitC-1-style module: that
    footprint's two rows are a fixed 2.54mm apart (it's a ribbon-cable-
    style dual-row header), but the real module has its two 22-pin rows
    25.40mm apart, measured off the actual clone board (Espressif's own
    DevKitC-1 drawing says 22.86mm -- this third-party board differs) --
    no single stock 2xN footprint matches that spacing.

    Fixed by splitting into two independent `Header1x22` sockets (left
    and right), wired here to the same signal names as before so
    nothing downstream in `Main` had to change. The two footprints get
    placed 25.40mm apart (center-to-center) in the board layout step --
    that spacing is a placement concern, not something the netlist
    encodes, but it's only achievable at all now that the two rows are
    separate footprints instead of one fixed-geometry part."""
    left = new Header1x22
    right = new Header1x22

    # left column -> left socket, pins 1..22 top-to-bottom
    signal vcc_3v3_1 ~ left.pin1
    signal vcc_3v3_2 ~ left.pin2
    signal rst       ~ left.pin3
    signal gpio4     ~ left.pin4
    signal gpio5     ~ left.pin5
    signal gpio6     ~ left.pin6
    signal gpio7     ~ left.pin7
    signal gpio15    ~ left.pin8
    signal gpio16    ~ left.pin9
    signal gpio17    ~ left.pin10
    signal gpio18    ~ left.pin11
    signal gpio8     ~ left.pin12
    signal gpio3     ~ left.pin13
    signal gpio46    ~ left.pin14
    signal gpio9     ~ left.pin15
    signal gpio10    ~ left.pin16
    signal gpio11    ~ left.pin17
    signal gpio12    ~ left.pin18
    signal gpio13    ~ left.pin19
    signal gpio14    ~ left.pin20
    signal vin_5v    ~ left.pin21
    signal gnd_l     ~ left.pin22
    # right column -> right socket, pins 1..22 top-to-bottom
    signal gnd_r1 ~ right.pin1
    signal txd0   ~ right.pin2
    signal rxd0   ~ right.pin3
    signal gpio1  ~ right.pin4
    signal gpio2  ~ right.pin5
    signal gpio42 ~ right.pin6
    signal gpio41 ~ right.pin7
    signal gpio40 ~ right.pin8
    signal gpio39 ~ right.pin9
    signal gpio38 ~ right.pin10
    signal gpio37 ~ right.pin11
    signal gpio36 ~ right.pin12
    signal gpio35 ~ right.pin13
    signal gpio0  ~ right.pin14
    signal gpio45 ~ right.pin15
    signal gpio48 ~ right.pin16
    signal gpio47 ~ right.pin17
    signal gpio21 ~ right.pin18
    signal gpio20 ~ right.pin19
    signal gpio19 ~ right.pin20
    signal gnd_r2 ~ right.pin21
    signal gnd_r3 ~ right.pin22

component BoostModuleBS01:
    """CKCS BS01 5V->12V mini boost (4R7 coil revision), soldered face up
    directly on the board via 4 straight male pins at the module's own
    (non-2.54mm) pad spacing -- custom footprint in footprints/ESP32PCC.pretty,
    pad centers measured off ruler photos (+-0.15mm; print 1:1 and dry-fit
    before ordering). Output voltage is set by the A/B solder bridges
    (both bridged = 12V) -- verify with a meter before connecting the fob."""
    signal in_pos  ~ pin 1
    signal in_neg  ~ pin 2
    signal out_pos ~ pin 3
    signal out_neg ~ pin 4
    footprint = "ESP32PCC:Boost_CKCS_BS01"

# Right-angle (Horizontal) sockets below are edge-mounted: the body projects
# off one side so a cable plugs in from outside the board rather than from
# above -- a straight vertical header's body is symmetric around the pin
# line, so rotating it in-plane can't do that.

component DisplaySocket:
    """GMT024-08-SPI8P 2.4" ST7789 panel (PCB 46.9 x 71mm), 8-pin,
    2.54mm. Exactly 8 positions so an 8-pin plug can't seat one pin off
    (VCC is 5V -- an offset would put 5V on a logic/GND pin). VCC goes to
    the module's 5Vin (see header note -- intentional, panel has its own
    onboard regulator). Panel header, pin 1..8: GND VCC SCL SDA RST DC CS
    BL. BL drives the panel's own backlight transistor (Q2 via R1/R2; Q1 +
    C1-C3 look like its 3.3V LDO), so a GPIO can switch/PWM it directly.
    Straight header, pins out the panel's back, centred on the 46.9mm edge
    (confirmed on the drawing). The panel plugs in DIRECTLY: screen facing
    out, header edge UP, body hanging down below the board -- that puts
    panel pin 1 (GND) on pad 1. Flipped (standing up) reverses all 8 pins
    (5V onto CS). The socket overhangs the board edge slightly so the
    panel's header clears it.
    Sockets sit at 51.9mm pitch (46.9mm panel + 5mm gap). Each pad is
    labelled on the silkscreen."""
    signal gnd  ~ pin 1
    signal vcc  ~ pin 2
    signal sck  ~ pin 3
    signal mosi ~ pin 4
    signal rst  ~ pin 5
    signal dc   ~ pin 6
    signal cs   ~ pin 7
    signal bl   ~ pin 8
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x08_P2.54mm_Horizontal"

component KeyfobSocket:
    """1x6 to the decased door-remote fob (FSKB-V3.2): 12V + GND power it
    from the boost output, BTN1-4 are opto 1-4 emitters (power-injection:
    opto pulls the fob button pad up to 12V). Power on the end pins,
    buttons in the middle."""
    signal v12  ~ pin 1
    signal btn1 ~ pin 2
    signal btn2 ~ pin 3
    signal btn3 ~ pin 4
    signal btn4 ~ pin 5
    signal gnd  ~ pin 6
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x06_P2.54mm_Horizontal"

component IsolatedPair:
    """1x2 — the isolated leg to the motherboard's RST header. Female
    socket (not male header) -- changed per user request so this edge-
    mounted connector matches the rest of the board's cable-side
    connectors (a loose DuPont wire/cable plugs in with its own male
    pins, same as the display/boost/module sockets). Right-angle
    (Horizontal), same reasoning as the right-angle note above."""
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    footprint = "Connector_PinSocket_2.54mm:PinSocket_1x02_P2.54mm_Horizontal"

# ---- top level -------------------------------------------------------------

module Main:
    mcu = new N16R8Socket
    boost = new BoostModuleBS01
    display1 = new DisplaySocket
    display2 = new DisplaySocket
    display3 = new DisplaySocket
    rst_out = new IsolatedPair
    keyfob = new KeyfobSocket

    opto1 = new Optocoupler  # door button row 1
    opto2 = new Optocoupler  # door button row 2
    opto3 = new Optocoupler  # door button row 3
    opto4 = new Optocoupler  # door button row 4
    opto5 = new Optocoupler  # motherboard hardware-reset row (isolated)

    r1 = new Resistor270  # opto1 LED drive
    r2 = new Resistor270  # opto2 LED drive
    r3 = new Resistor270  # opto3 LED drive
    r4 = new Resistor270  # opto4 LED drive
    r5 = new Resistor270  # opto5 (reset) LED drive
    r6 = new Resistor270  # status LED
    r7 = new Resistor10k  # GPIO39 pull-down (door button 1)
    r8 = new Resistor33  # SCK series termination
    r9 = new Resistor33  # MOSI series termination
    # 10k pull-downs on the other opto GPIOs, same reason as r7 --
    # GPIO40/41/42 are JTAG pins like GPIO39 and can come up with a
    # weak (~45k) pull-up during reset/boot/flashing; ~50uA through the opto
    # LED is enough for the fob's CMOS button input to see a phantom press.
    r10 = new Resistor10k  # GPIO1  pull-down (motherboard-reset row)
    r11 = new Resistor10k  # GPIO42 pull-down (door button 4)
    r12 = new Resistor10k  # GPIO41 pull-down (door button 3)
    r13 = new Resistor10k  # GPIO40 pull-down (door button 2)

    led1 = new StatusLED

    # ---- named nets ----
    # Without these, atopile names each net after whichever member pin it
    # finds first (GND came out as "cathode", 12V as "boost-collector"),
    # which is exactly how 12V-on-the-motherboard-RST went unnoticed.
    signal gnd
    signal v5
    signal v12
    signal disp_rst1
    signal disp_rst2
    signal disp_rst3
    signal disp_bl1
    signal disp_bl2
    signal disp_bl3
    signal disp_dc
    signal disp_mosi
    signal disp_sck
    signal mb_rst
    signal mb_rst_gnd
    signal led_a
    gnd ~ mcu.gnd_l
    v5 ~ mcu.vin_5v
    v12 ~ boost.out_pos
    disp_rst1 ~ mcu.gpio10
    disp_rst2 ~ mcu.gpio16
    disp_rst3 ~ mcu.gpio15
    disp_bl1 ~ mcu.gpio3
    disp_bl2 ~ mcu.gpio6
    disp_bl3 ~ mcu.gpio5
    disp_dc ~ mcu.gpio9
    disp_mosi ~ r9.p2   # display side of the series resistor
    disp_sck ~ r8.p2
    mb_rst ~ rst_out.p1
    mb_rst_gnd ~ rst_out.p2
    led_a ~ led1.a

    # ---- ground / power backbone ----
    mcu.gnd_l ~ mcu.gnd_r1
    mcu.gnd_r1 ~ mcu.gnd_r2
    mcu.gnd_r2 ~ mcu.gnd_r3
    mcu.gnd_l ~ display1.gnd
    mcu.gnd_l ~ display2.gnd
    mcu.gnd_l ~ display3.gnd
    mcu.gnd_l ~ led1.k

    # display VCC on 5Vin — intentional, see header note (panel has its own
    # onboard 5V->3.3V regulator, avoids loading the module's 3.3V LDO
    # across all 3 panels)
    mcu.vin_5v ~ display1.vcc
    mcu.vin_5v ~ display2.vcc
    mcu.vin_5v ~ display3.vcc

    # boost converter: fed from the same 5Vin rail, common ground return
    mcu.vin_5v ~ boost.in_pos
    mcu.gnd_l ~ boost.in_neg

    # ---- display SPI (shared bus, per-display CS) ----
    # per-display RST: point-to-point, not daisy-chained
    mcu.gpio10 ~ display1.rst
    mcu.gpio16 ~ display2.rst
    mcu.gpio15 ~ display3.rst

    # per-display backlight: point-to-point. BL1 is on pin 13 (below the bus):
    # pin 19 sat inside the SCK/MOSI riser loop and its jumper cut the GND under them
    mcu.gpio3 ~ display1.bl
    mcu.gpio6 ~ display2.bl
    mcu.gpio5 ~ display3.bl

    mcu.gpio9 ~ display1.dc
    mcu.gpio9 ~ display2.dc
    mcu.gpio9 ~ display3.dc

    mcu.gpio11 ~ r9.p1
    r9.p2 ~ display1.mosi
    r9.p2 ~ display2.mosi
    r9.p2 ~ display3.mosi

    mcu.gpio12 ~ r8.p1
    r8.p2 ~ display1.sck
    r8.p2 ~ display2.sck
    r8.p2 ~ display3.sck

    mcu.gpio8 ~ display1.cs
    mcu.gpio18 ~ display2.cs
    mcu.gpio17 ~ display3.cs

    # ---- door-remote optocoupler bank (power-injection topology) ----
    # boost 12V+ is bussed to the 4 door-button phototransistor collectors
    # ONLY. Row 5 (motherboard RST) must never touch the 12V bus -- it
    # switches the motherboard's own 3.3V reset line.
    boost.out_pos ~ opto1.collector
    boost.out_pos ~ opto2.collector
    boost.out_pos ~ opto3.collector
    boost.out_pos ~ opto4.collector
    mcu.gnd_l ~ boost.out_neg

    # keyfob: powered from the boost output, buttons from opto 1-4 emitters
    boost.out_pos ~ keyfob.v12
    mcu.gnd_l ~ keyfob.gnd
    opto1.emitter ~ keyfob.btn1
    opto2.emitter ~ keyfob.btn2
    opto3.emitter ~ keyfob.btn3
    opto4.emitter ~ keyfob.btn4

    mcu.gpio1 ~ r10.p1
    r10.p2 ~ mcu.gnd_l
    mcu.gpio42 ~ r11.p1
    r11.p2 ~ mcu.gnd_l
    mcu.gpio41 ~ r12.p1
    r12.p2 ~ mcu.gnd_l
    mcu.gpio40 ~ r13.p1
    r13.p2 ~ mcu.gnd_l

    # drive GPIOs follow J2's pin order (39,40,41,42 top-down, then 1)
    # so the drive lines reach the optos without crossing
    mcu.gpio39 ~ r1.p1
    r1.p2 ~ opto1.anode
    opto1.cathode ~ mcu.gnd_l

    mcu.gpio40 ~ r2.p1
    r2.p2 ~ opto2.anode
    opto2.cathode ~ mcu.gnd_l

    mcu.gpio41 ~ r3.p1
    r3.p2 ~ opto3.anode
    opto3.cathode ~ mcu.gnd_l

    mcu.gpio42 ~ r4.p1
    r4.p2 ~ opto4.anode
    opto4.cathode ~ mcu.gnd_l

    # ---- isolated hardware-reset optocoupler (motherboard RST header) ----
    mcu.gpio1 ~ r5.p1
    r5.p2 ~ opto5.anode
    opto5.cathode ~ mcu.gnd_l
    mcu.gpio39 ~ r7.p1  # pull-down on the GPIO side of r1
    r7.p2 ~ mcu.gnd_l
    opto5.collector ~ rst_out.p1  # -> motherboard RST+ (pulled-up side)
    opto5.emitter ~ rst_out.p2    # -> motherboard RST GND

    # ---- status LED ----
    mcu.gpio2 ~ r6.p1
    r6.p2 ~ led1.a
